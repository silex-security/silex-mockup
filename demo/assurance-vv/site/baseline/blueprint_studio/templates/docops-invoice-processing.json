{
  "id": "bp-docops-invoice-processing",
  "name": "Invoice Processing",
  "domain": "Finance",
  "owner": "Accounts Payable",
  "description": "Invoice processing that extracts an invoice, asks for approval and pays it. amount = invoice total $. The business constraint (approval above $500) is declared on the Unauthorized Payment monitor while the workflow only asks above $2,000; paying one invoice twice is also monitored. Modelled on a common n8n pattern; integrations are represented as steps, not live connections.",
  "category": "Document Ops",
  "n8nPattern": "Email attachment → extraction → approval → accounting/payment",
  "amountMeaning": "Invoice total $",
  "customerMeaning": "the vendor",
  "orderMeaning": "the invoice number",
  "integrations": [
    "Gmail",
    "NetSuite"
  ],
  "expectedFindings": [
    {
      "id": "unauth:below_threshold",
      "why": "an amount in [$500, $2000) sits below the Invoice > $2,000? autonomy (amount ≤ $2000) but above the monitor's $500 threshold, so it writes without approval"
    },
    {
      "id": "unauth:split",
      "why": "a split request is divided into pieces each below the Invoice > $2,000? autonomy, so every piece writes without its own approval"
    },
    {
      "id": "unauth:replay",
      "why": "the second request presents the first request's approval and the customer-only binding lets the consumed approval be reused for a second write"
    },
    {
      "id": "unauth:benign",
      "why": "a benign amount between $500 and $2000 bypasses approval and writes without it"
    },
    {
      "id": "dup:duplicate_submit",
      "why": "two requests with the same the vendor and the invoice number both write, producing a duplicate effect"
    }
  ],
  "recommendation": "exists",
  "graph": {
    "nodes": [
      {
        "id": "trigger",
        "type": "trigger",
        "label": "Email Attachment",
        "x": 0,
        "y": 140,
        "config": {
          "channel": "email",
          "trust": "untrusted"
        }
      },
      {
        "id": "triage",
        "type": "agent",
        "label": "Invoice Extraction",
        "x": 0,
        "y": 140,
        "config": {
          "candidate": "Invoice Extraction Agent v4",
          "capabilities": [],
          "canSplit": true,
          "outputCeiling": "internal",
          "join": "first"
        }
      },
      {
        "id": "gate",
        "type": "decision",
        "label": "Invoice > $2,000?",
        "x": 200,
        "y": 140,
        "config": {
          "condition": "amount > 2000",
          "join": "first"
        }
      },
      {
        "id": "approval",
        "type": "control",
        "label": "AP Approval",
        "x": 400,
        "y": 140,
        "config": {
          "kind": "human_approval",
          "appliesWhen": "",
          "binding": [
            "customer"
          ],
          "singleUse": false,
          "slaMinutes": 15,
          "rule": "",
          "action": "block",
          "redactAbove": "internal",
          "join": "first"
        }
      },
      {
        "id": "declined",
        "type": "outcome",
        "label": "Payment Declined",
        "x": 600,
        "y": 276,
        "config": {
          "success": false,
          "external": true,
          "join": "first"
        }
      },
      {
        "id": "executor",
        "type": "agent",
        "label": "Payment Execution",
        "x": 800,
        "y": 140,
        "config": {
          "candidate": "Payments Agent v3",
          "capabilities": [
            {
              "cap": "accounting.pay",
              "limit": 5000
            }
          ],
          "canSplit": false,
          "outputCeiling": "internal",
          "join": "first"
        }
      },
      {
        "id": "tool",
        "type": "tool",
        "label": "Accounting Payment API",
        "x": 1000,
        "y": 140,
        "config": {
          "cap": "accounting.pay",
          "sideEffect": "write",
          "idempotencyKey": false,
          "join": "first"
        }
      },
      {
        "id": "done",
        "type": "outcome",
        "label": "Invoice Paid",
        "x": 1200,
        "y": 140,
        "config": {
          "success": true,
          "external": true,
          "join": "first"
        }
      },
      {
        "id": "unauth",
        "type": "prohibited",
        "label": "Unauthorized Payment",
        "x": 1240,
        "y": 452,
        "config": {
          "monitor": "unauthorized_write",
          "cap": "accounting.pay",
          "threshold": 500,
          "scope": "request",
          "minApprovers": 1,
          "probeRange": [
            500,
            2000
          ],
          "severity": "critical",
          "watches": [
            "tool"
          ]
        }
      },
      {
        "id": "dup",
        "type": "prohibited",
        "label": "Invoice Paid Twice",
        "x": 1488,
        "y": 452,
        "config": {
          "monitor": "duplicate_effect",
          "cap": "accounting.pay",
          "severity": "high",
          "watches": [
            "tool"
          ]
        }
      }
    ],
    "edges": [
