        "x": 1000,
        "y": 140,
        "config": {
          "candidate": "Credit Agent v2",
          "capabilities": [
            {
              "cap": "goodwill.credit",
              "limit": 5000
            }
          ],
          "canSplit": false,
          "outputCeiling": "internal",
          "join": "first"
        }
      },
      {
        "id": "tool",
        "type": "tool",
        "label": "Goodwill Credit API",
        "x": 1200,
        "y": 140,
        "config": {
          "cap": "goodwill.credit",
          "sideEffect": "write",
          "idempotencyKey": false,
          "join": "first"
        }
      },
      {
        "id": "done",
        "type": "outcome",
        "label": "Reply Sent",
        "x": 1400,
        "y": 140,
        "config": {
          "success": true,
          "external": true,
          "join": "first"
        }
      },
      {
        "id": "unauth",
        "type": "prohibited",
        "label": "Unauthorized Goodwill Credit",
        "x": 1240,
        "y": 452,
        "config": {
          "monitor": "unauthorized_write",
          "cap": "goodwill.credit",
          "threshold": 100,
          "scope": "request",
          "minApprovers": 1,
          "probeRange": [
            100,
            500
          ],
          "severity": "critical",
          "watches": [
            "tool"
          ]
        }
      },
      {
