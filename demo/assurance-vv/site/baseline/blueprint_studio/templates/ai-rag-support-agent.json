          "redactAbove": "internal",
          "join": "first"
        }
      },
      {
        "id": "declined",
        "type": "outcome",
        "label": "Credit Declined",
        "x": 800,
        "y": 276,
        "config": {
          "success": false,
          "external": true,
          "join": "first"
        }
      },
      {
        "id": "executor",
        "type": "agent",
