{
  "id": "bp-vendor-bank-change",
  "name": "Vendor Bank-Detail Change",
  "domain": "Finance",
  "owner": "Accounts Payable",
  "description": "Vendor bank-detail change requests arriving by email (the shape of incident I-1042). amount = payment exposure of the changed record. Every change needs approval (monitor threshold 0); the declared workflow asks only above $10,000.",
  "graph": {
    "nodes": [
      {
        "id": "vendorMaster",
        "type": "data",
        "label": "Vendor Master Records",
        "x": 240,
        "y": 0,
        "config": {
          "sensitivity": "internal"
        }
      },
      {
        "id": "email",
        "type": "trigger",
        "label": "Vendor Email",
        "x": 20,
        "y": 150,
        "config": {
          "channel": "email",
          "trust": "untrusted"
        }
      },
      {
        "id": "finance",
        "type": "agent",
        "label": "Finance Agent",
        "x": 240,
        "y": 150,
        "config": {
          "candidate": "Finance Agent v2",
          "capabilities": [],
          "canSplit": false,
          "outputCeiling": "internal",
          "join": "first"
        }
      },
      {
        "id": "procurement",
        "type": "agent",
        "label": "Procurement Agent",
        "x": 460,
        "y": 150,
        "config": {
          "candidate": "Procurement Agent v1",
          "capabilities": [
            {
              "cap": "vendor.update",
              "limit": 50000
            }
          ],
          "canSplit": true,
          "outputCeiling": "internal",
          "join": "first"
        }
      },
      {
        "id": "vgate",
        "type": "decision",
        "label": "Exposure > $10,000?",
        "x": 680,
        "y": 150,
        "config": {
          "condition": "amount > 10000",
          "join": "first"
        }
      },
      {
        "id": "vapproval",
        "type": "control",
        "label": "Finance Approval",
        "x": 680,
        "y": 330,
        "config": {
          "kind": "human_approval",
          "appliesWhen": "",
          "binding": [
            "customer"
          ],
          "singleUse": false,
          "slaMinutes": 30,
          "rule": "",
          "action": "block",
          "redactAbove": "internal",
          "join": "first"
        }
      },
      {
        "id": "vrejected",
        "type": "outcome",
        "label": "Change Rejected",
        "x": 900,
        "y": 330,
        "config": {
          "success": false,
          "external": true,
          "join": "first"
        }
      },
      {
        "id": "vendorApi",
        "type": "tool",
        "label": "Vendor Master API",
        "x": 460,
        "y": 330,
        "config": {
          "cap": "vendor.update",
          "sideEffect": "write",
          "idempotencyKey": false,
          "join": "first"
        }
      },
      {
        "id": "applied",
        "type": "outcome",
        "label": "Change Applied",
        "x": 240,
        "y": 330,
        "config": {
          "success": true,
          "external": true,
          "join": "first"
        }
      },
      {
        "id": "vunauth",
        "type": "prohibited",
        "label": "Unauthorized Vendor Change",
        "x": 460,
        "y": 510,
        "config": {
          "monitor": "unauthorized_write",
          "cap": "vendor.update",
          "threshold": 0,
          "scope": "request",
          "minApprovers": 1,
          "probeRange": [
            0,
            10000
          ],
          "severity": "critical",
          "watches": [
            "vendorApi"
          ]
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "kind": "flow",
        "from": {
          "node": "email",
          "port": "out"
        },
        "to": {
          "node": "finance",
          "port": "in"
        }
      },
      {
        "id": "e2",
        "kind": "flow",
        "from": {
          "node": "finance",
          "port": "out"
        },
        "to": {
          "node": "procurement",
          "port": "in"
        }
      },
      {
        "id": "e3",
        "kind": "flow",
        "from": {
          "node": "procurement",
          "port": "out"
        },
        "to": {
          "node": "vgate",
          "port": "in"
        }
      },
      {
        "id": "e4",
        "kind": "flow",
        "from": {
          "node": "vgate",
          "port": "true"
        },
        "to": {
          "node": "vapproval",
          "port": "in"
        }
      },
      {
        "id": "e5",
        "kind": "flow",
        "from": {
          "node": "vgate",
          "port": "false"
        },
        "to": {
          "node": "vendorApi",
          "port": "in"
        }
      },
      {
        "id": "e6",
        "kind": "flow",
        "from": {
          "node": "vapproval",
          "port": "approved"
        },
        "to": {
          "node": "vendorApi",
          "port": "in"
        }
      },
      {
        "id": "e7",
        "kind": "flow",
        "from": {
          "node": "vapproval",
          "port": "denied"
        },
        "to": {
          "node": "vrejected",
          "port": "in"
        }
      },
      {
        "id": "e8",
        "kind": "flow",
        "from": {
          "node": "vendorApi",
          "port": "out"
        },
        "to": {
          "node": "applied",
          "port": "in"
        }
      },
      {
        "id": "a1",
        "kind": "access",
        "mode": "read",
        "from": {
          "node": "finance",
          "port": "acc"
        },
        "to": {
          "node": "vendorMaster",
          "port": "acc"
        }
      }
    ]
  }
}
